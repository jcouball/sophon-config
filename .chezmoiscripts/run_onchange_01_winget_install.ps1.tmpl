# Install everything in the winget manifest (layer 2: apps and core CLI tools).
#
# Re-runs only when winget-packages.json changes -- the hash below is what makes
# that work. Regenerate the manifest after installing or removing anything by
# running `Update-WingetManifest`, defined in ~/.config/powershell/profile.ps1.
# That function also strips the deliberately excluded packages, which
# `winget export` keeps re-adding, and documents which they are and why. The
# list lives there and only there.
#
# manifest hash: {{ include "winget-packages.json" | sha256sum }}

$manifest = Join-Path '{{ .chezmoi.sourceDir }}' 'winget-packages.json'

if (-not (Test-Path $manifest)) {
    Write-Warning "winget manifest not found at $manifest"
    return
}

# PORTABLE PACKAGES ARE IMPORTED SEPARATELY. A portable package is one winget
# unpacks into the user's own %LOCALAPPDATA%\Microsoft\WinGet\Packages, with
# no installer. From winget 1.30 an import run from an elevated terminal
# refuses them: "The requested operation is not permitted from an
# administrator context on packages installed within the user scope." The
# rest of the manifest needs the elevation, so the manifest is split in two.
# The packages named here are imported from a scheduled task that runs as
# this user with no elevated terminal behind it, which winget accepts; the
# rest are imported here as before. Issue #39 has what was measured.
#
# Add a package here when it is portable. `winget show --id <id>` says
# "Installer Type: portable", or "zip" for a portable program inside an
# archive, and once installed it has a folder under the path above.
#
# twpayne.chezmoi is portable too and is not here: it is installed before this
# script can run, and --no-upgrade leaves an installed package alone.
$portableIds = @('Anthropic.ClaudeCode', 'jdx.mise', 'topgrade-rs.topgrade')

# The manifest as two manifests: the packages named in $Ids, and the rest.
# A source left with no packages is dropped. Either may come back empty, with
# no Sources. Takes and returns JSON text, so a test can call it.
function Split-WingetManifest($Text, $Ids) {
    $result = @{}
    foreach ($part in 'Main', 'Portable') {
        $copy = $Text | ConvertFrom-Json
        $sources = @()
        $count = 0
        foreach ($source in @($copy.Sources)) {
            $kept = @($source.Packages | Where-Object { ($Ids -contains $_.PackageIdentifier) -eq ($part -eq 'Portable') })
            if ($kept.Count -eq 0) { continue }
            $source.Packages = $kept
            $sources += $source
            $count += $kept.Count
        }
        $copy.Sources = $sources
        $result[$part] = $copy | ConvertTo-Json -Depth 10
        $result["${part}Count"] = $count
    }
    $result
}

# A PACKAGE WHOSE INSTALLER FOUND WINDOWS INSTALLER BUSY IS IMPORTED AGAIN.
# Windows Installer runs one installation at a time, and an MSI started while
# another is running ends at once with exit code 1618. winget import goes on
# to the next package and does not come back. The other installation need not
# be one of winget's: the WSL package is done, as far as winget can tell, once
# it is registered, and its service then installs wsl.msi for another 13
# seconds. A certification run lost Tailscale, the next package, that way.
$busyTries = 3          # more imports of the packages that found it busy
$busyWaitSeconds = 30   # before each one

# The ids of the packages whose installer ended with exit code 1618, from the
# lines winget import printed. winget names each package on a line of its own,
# "(19/20) Found Tailscale [Tailscale.Tailscale] Version 1.104.7", before the
# lines about it. Takes text and returns ids, so a test can call it.
function Get-WingetBusyIds($Lines) {
    $ids = @()
    $current = $null
    foreach ($line in @($Lines)) {
        if ("$line" -match '^\s*\(\d+/\d+\) .*\[([^\[\]]+)\]') { $current = $Matches[1]; continue }
        if ($current -and "$line" -match 'exit code: 1618\s*$') { $ids += $current; $current = $null }
    }
    $ids
}

# What became of one package that was imported again by itself, from the
# lines winget printed and its exit code: 'installed', 'busy' when its
# installer ended with 1618 again, or 'failed' for any other ending. winget
# import exits 0 for a package it installed and for one already installed.
# Takes text and a number, so a test can call it.
function Get-WingetAgainResult($Lines, $ExitCode) {
    if ($ExitCode -eq 0) { return 'installed' }
    if (@(Get-WingetBusyIds $Lines).Count -gt 0) { return 'busy' }
    'failed'
}

# Run winget import here, print what it prints, and return the lines. winget's
# exit code is in $LASTEXITCODE afterwards.
function Invoke-WingetImport($ManifestPath, $Flags) {
    winget import --import-file $ManifestPath @Flags | ForEach-Object {
        $line = "$_"
        # winget draws its progress bars and spinner as lines of their own.
        if ($line.Trim() -and $line -notmatch '[\u2588\u2592]' -and $line -notmatch '^\s*[-\\|/]\s*$') { Write-Host $line }
        $line
    }
}

function Test-Elevated() {
    ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)
}

# --ignore-unavailable: publishers drop old manifests, and without it one missing
#   package aborts the entire import.
# --no-upgrade: this layer's job is to ensure a package is PRESENT, not current.
#   Currency belongs to topgrade. Without this, every manifest change re-runs
#   this script and upgrades every package as a side effect -- which is exactly
#   the "global update breaks a pinned project" failure the whole stack avoids.
# --disable-interactivity: an unattended rebuild must never stop on a prompt.
#
# NOTE: `winget import` has no --silent flag (unlike `winget install`), so
# installers that launch their own UI will do so mid-run -- Warp opens a welcome
# window. The rebuild is therefore not fully unattended: expect windows to appear
# and steal focus. Nothing breaks; it just needs a human nearby.
$importFlags = '--ignore-unavailable', '--no-upgrade', '--disable-interactivity',
    '--accept-package-agreements', '--accept-source-agreements'

# Run the portable import as a scheduled task and wait for it, printing what
# it prints. The task logs on as this user without a password (S4U), so it
# needs no desktop and works in an ssh session. It is removed afterwards.
# The task is named for this process, so two applies at once, by two users,
# each have their own. Returns winget's exit code, or -1 if the task did not
# finish.
function Invoke-PortableImport($ManifestPath, $Flags, $LogPath, $Minutes) {
    $task = "windows-dev-config-winget-portable-$PID"
    # The paths go into single-quoted PowerShell text, where '' is one quote.
    $quotedManifest = $ManifestPath.Replace("'", "''")
    $quotedLog = $LogPath.Replace("'", "''")
    $command = "& { winget import --import-file '$quotedManifest' $($Flags -join ' '); 'WINGET EXIT ' + `$LASTEXITCODE } *> '$quotedLog'"
    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))
    $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument "-NoProfile -ExecutionPolicy Bypass -EncodedCommand $encoded"
    $principal = New-ScheduledTaskPrincipal -UserId ([Security.Principal.WindowsIdentity]::GetCurrent().Name) -LogonType S4U -RunLevel Limited
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::FromMinutes($Minutes + 5))
    Register-ScheduledTask -TaskName $task -Action $action -Principal $principal -Settings $settings -Force | Out-Null
    $code = -1
    try {
        Start-ScheduledTask -TaskName $task
        $shown = 0
        $deadline = (Get-Date).AddMinutes($Minutes)
        while ($true) {
            Start-Sleep -Seconds 3
            $lines = @()
            if (Test-Path $LogPath) { $lines = @(Get-Content $LogPath -ErrorAction SilentlyContinue) }
            foreach ($line in @($lines | Select-Object -Skip $shown)) {
                if ($line -match '^WINGET EXIT (-?\d+)') { $code = [int]$Matches[1]; continue }
                # winget draws its progress bars and spinner as lines of their own.
                if ($line.Trim() -and $line -notmatch '[\u2588\u2592]' -and $line -notmatch '^\s*[-\\|/]\s*$') { Write-Host "    $line" }
            }
            $shown = $lines.Count
            if ($code -ne -1) { break }
            if ((Get-Date) -gt $deadline) { break }
            if ($shown -eq 0 -and (Get-ScheduledTask -TaskName $task).State -ne 'Running' -and
                (Get-ScheduledTaskInfo -TaskName $task).LastTaskResult -notin 0, 267009, 267011, 267045) {
                Write-Warning "The task did not start winget: result $((Get-ScheduledTaskInfo -TaskName $task).LastTaskResult)."
                break
            }
        }
    } finally {
        Stop-ScheduledTask -TaskName $task -ErrorAction SilentlyContinue
        Unregister-ScheduledTask -TaskName $task -Confirm:$false -ErrorAction SilentlyContinue
    }
    $code
}

$split = Split-WingetManifest ([IO.File]::ReadAllText($manifest)) $portableIds
$work = Join-Path ([IO.Path]::GetTempPath()) "windows-dev-config-winget-$PID"
New-Item -ItemType Directory -Force -Path $work | Out-Null
$utf8 = New-Object Text.UTF8Encoding $false
$portableFailed = $false
$busyFailed = $false
try {
    if ($split.MainCount -gt 0) {
        $mainManifest = Join-Path $work 'main.json'
        [IO.File]::WriteAllText($mainManifest, $split.Main, $utf8)
        Write-Host "Importing $($split.MainCount) packages from $manifest ..."
        $busy = @(Get-WingetBusyIds (Invoke-WingetImport $mainManifest $importFlags))
        # One package to an import from here on, so that winget's exit code
        # says what became of that package.
        $failedAgain = @()
        foreach ($try in 1..$busyTries) {
            if ($busy.Count -eq 0) { break }
            Write-Host "Windows Installer was busy when these were installed: $($busy -join ', ')."
            Write-Host "Importing them again in $busyWaitSeconds seconds (try $try of $busyTries) ..."
            Start-Sleep -Seconds $busyWaitSeconds
            $stillBusy = @()
            foreach ($id in $busy) {
                # The split's "portable" part is the packages it is given by name.
                $againManifest = Join-Path $work 'again.json'
                [IO.File]::WriteAllText($againManifest, (Split-WingetManifest $split.Main @($id)).Portable, $utf8)
                $lines = @(Invoke-WingetImport $againManifest $importFlags)
                $code = $LASTEXITCODE
                switch (Get-WingetAgainResult $lines $code) {
                    'busy' { $stillBusy += $id }
                    'failed' {
                        Write-Warning "Importing $id again ended with exit code $code, so it is not installed. Rerun chezmoi apply once it is fixed."
                        $failedAgain += $id
                    }
                }
            }
            $busy = $stillBusy
        }
        if ($busy.Count -gt 0) {
            Write-Warning "Windows Installer was still busy after $busyTries more tries, so these are not installed: $($busy -join ', '). Rerun chezmoi apply."
        }
        if ($busy.Count -gt 0 -or $failedAgain.Count -gt 0) { $busyFailed = $true }
    }

    # After the rest: the portable packages depend on the Visual C++ runtime,
    # which is in the other part and needs the elevation.
    if ($split.PortableCount -gt 0) {
        $portableManifest = Join-Path $work 'portable.json'
        [IO.File]::WriteAllText($portableManifest, $split.Portable, $utf8)
        Write-Host "Importing the $($split.PortableCount) portable packages ..."
        if (Test-Elevated) {
            $code = Invoke-PortableImport $portableManifest $importFlags (Join-Path $work 'portable.log') 60
        } else {
            winget import --import-file $portableManifest @importFlags
            $code = $LASTEXITCODE
        }
        if ($code -eq -1) {
            Write-Warning 'The portable import did not finish. Rerun chezmoi apply.'
            $portableFailed = $true
        } elseif ($code -ne 0) {
            Write-Warning "The portable import ended with exit code $code. Rerun chezmoi apply once it is fixed."
            $portableFailed = $true
        }
    }
} finally {
    # A task that was stopped holds its log open for a moment longer.
    foreach ($try in 1..10) {
        Remove-Item $work -Recurse -Force -ErrorAction SilentlyContinue
        if (-not (Test-Path $work)) { break }
        Start-Sleep -Seconds 1
    }
}

# EXIT 1 WHEN THE PORTABLE IMPORT FAILED, OR A PACKAGE THAT FOUND WINDOWS
# INSTALLER BUSY WAS NOT INSTALLED BY THE LATER TRIES, WHETHER IT STAYED BUSY
# OR FAILED ANOTHER WAY. chezmoi records a run_onchange script as done
# when it exits 0, and does not run it again until the manifest changes.
# Exiting 0 here would leave mise and the others missing for good. After the
# finally, so the temporary folder is gone either way.
if ($portableFailed -or $busyFailed) { exit 1 }
