# Materialise the tools pinned in mise's config.
#
# The config file itself is managed by chezmoi (dot_config/mise/config.toml), but
# applying it only writes the declaration -- the runtimes still have to be
# downloaded. This re-runs whenever that file changes, and no other time.
#
# NOTE: include resolves against the SOURCE directory, so this is the source
# name (dot_config/...), not the target name (.config/...).
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

# Refresh PATH from the registry first. mise is installed by script 01 in this
# same chezmoi run, and winget adds its directory to the *user* PATH -- but this
# process inherited its environment before that happened, and Windows never
# propagates PATH changes into a running process. Without this, a fresh machine
# fails here: mise "not found", the script returns cleanly, and none of the
# pinned runtimes ever install.
$env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' +
            [Environment]::GetEnvironmentVariable('Path', 'User')

if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
    Write-Warning 'mise is not on PATH even after refreshing it - check that script 01 installed jdx.mise.'
    return
}

Write-Host 'Installing pinned tools from ~/.config/mise/config.toml ...'
mise install

Write-Host ''
mise ls --current
