# Build the shared MSYS2 toolchains and link every mise Ruby to one of them.
#
# mise installs Ruby on Windows from RubyInstaller2, but it installs the *bare*
# build -- no compiler. Nothing complains until the first `bundle install` in a
# project with native gems, which fails on every one of them (bigdecimal, json,
# prism, erb, io-console, ...) with:
#
#   The compiler failed to generate an executable file.
#   You have to install development tools first.
#
# `ridk version` is not evidence either way. It reports a `cc:` line baked in at
# build time on RubyInstaller's CI, so it names a compiler this machine has never
# had. Check for gcc, not for ridk's opinion of gcc.
#
# The work is in ~/.local/bin/ruby-toolchains.ps1, not here, because two other
# callers need it: mise's postinstall hook, which links a Ruby the moment it is
# installed, and anyone who wants to rerun it by hand. That file's header says
# what it builds and why. This script is the trigger.
#
# THIS REPLACED `ridk install 1 3`, which put an MSYS2 inside the one Ruby that
# config.toml pins and nowhere else. The README's "Ruby native extensions"
# section records why that was chosen and what changed.
#
# WHAT RE-RUNS IT. Any of the three hashes below changing:
#
#   - the pins: a new toolchain, date, package or base archive
#   - the mise config: a Ruby bump installs a Ruby with no link yet. The hook
#     normally links it first, during script 04; this run is what catches a
#     hook that failed, and it costs a few seconds when there is nothing to do.
#   - the worker script or its helper
#
# pins hash:        {{ .rubyToolchains | toJson | sha256sum }}
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# worker hash:      {{ include "dot_local/bin/ruby-toolchains.ps1.tmpl" | sha256sum }}
# helper hash:      {{ include "dot_local/bin/ruby-toolchains-packages.sh" | sha256sum }}
#
# THE `after_` ATTRIBUTE IS REQUIRED, for the reason script 04's header gives:
# without it this runs before chezmoi has written the worker script.
#
# The worker finds Ruby by path and needs neither mise nor ruby on PATH, so this
# script does not refresh PATH the way scripts 04 and 07 do.

$worker = Join-Path $HOME '.local\bin\ruby-toolchains.ps1'

if (-not (Test-Path $worker)) {
    Write-Warning "$worker is missing, so no toolchain was built and native gems will not build. chezmoi should have written it before this script ran."
    exit 1
}

Write-Host 'Checking the Ruby toolchains (a new one is about 1 GB and takes a few minutes) ...'

# A separate process, so the worker's `exit` ends the worker and not this script.
& powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $worker

# Fail the apply when the worker failed. chezmoi records a run_onchange script
# as done only when it exits 0, so a failure here is retried by the next
# `chezmoi apply` instead of being remembered as success until a pin changes.
if ($LASTEXITCODE -ne 0) {
    Write-Warning 'ruby-toolchains.ps1 reported a failure (see above). Rerun chezmoi apply once it is fixed.'
    exit 1
}
